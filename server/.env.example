# Server Port & Environment
PORT=5000
NODE_ENV=production

# Database (Amazon DocumentDB / MongoDB Atlas)
# For Amazon DocumentDB: mongodb://<username>:<password>@<docdb-cluster-endpoint>:27017/moulyasree?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_URI=mongodb://127.0.0.1:27017/moulyasree

# Security & Payment
JWT_SECRET=your_super_secret_jwt_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key

# AWS Core Configuration
AWS_REGION=us-east-1
# When running on AWS App Runner / ECS / EC2 with IAM Roles attached, credentials below are optional!
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Amazon Bedrock Generative AI
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon S3 & CloudFront CDN Media Storage
AWS_S3_BUCKET_NAME=moulyasree-tourism-bucket
AWS_CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
USE_S3_STORAGE=true

# Amazon DynamoDB Inventory Catalog
DYNAMODB_TABLE_HOTELS=Moulyasree_Hotels
DYNAMODB_TABLE_VEHICLES=Moulyasree_Vehicles
DYNAMODB_TABLE_RESTAURANTS=Moulyasree_Restaurants
DYNAMODB_TABLE_GUIDES=Moulyasree_Guides

# Local Ollama Fallback (Development Only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
